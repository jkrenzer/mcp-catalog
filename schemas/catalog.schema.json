{
  "$defs": {
    "BuildOptions": {
      "additionalProperties": false,
      "description": "Docker Buildx options for a build server.",
      "properties": {
        "platforms": {
          "description": "Target platforms passed to docker buildx build --platform.",
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Build arguments (--build-arg). Never put credentials here.",
          "title": "Args",
          "type": "object"
        }
      },
      "title": "BuildOptions",
      "type": "object"
    },
    "BuildServer": {
      "additionalProperties": false,
      "description": "Server image built by this catalog from a Git checkout or a local context.",
      "properties": {
        "schema_version": {
          "const": 1,
          "description": "Manifest schema version; must be 1.",
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "description": "Unique lowercase server name; also the catalog registry key.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "const": "build",
          "description": "Built from source by this catalog.",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "description": "Human-readable display name.",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "Short description of the server.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Disabled servers are excluded from output.",
          "title": "Enabled",
          "type": "boolean"
        },
        "icon": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of a small PNG, SVG or favicon logo (max 512x512).",
          "title": "Icon"
        },
        "readme": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of the server documentation.",
          "title": "Readme"
        },
        "upstream": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of the upstream project. Defaults to the Git source repository for build servers; set it when the image wraps a project hosted elsewhere.",
          "title": "Upstream"
        },
        "date_added": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the server was added to the catalog (RFC 3339). Declared, not computed.",
          "title": "Date Added"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataModel",
          "description": "Category, tags, license and owner."
        },
        "tools": {
          "description": "Tools advertised in the catalog, declared inline.",
          "items": {
            "$ref": "#/$defs/ToolModel"
          },
          "title": "Tools",
          "type": "array"
        },
        "tools_file": {
          "anyOf": [
            {
              "format": "file-path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON or YAML file containing the tools list instead of declaring it inline. Relative paths resolve from the manifest directory; $GIT_BASE, $CWD and environment variables are expanded. Mutually exclusive with tools.",
          "title": "Tools File"
        },
        "secrets": {
          "description": "Secrets the gateway injects at start-up.",
          "items": {
            "$ref": "#/$defs/SecretModel"
          },
          "title": "Secrets",
          "type": "array"
        },
        "config": {
          "description": "User-configurable settings schemas.",
          "items": {
            "$ref": "#/$defs/ConfigModel"
          },
          "title": "Config",
          "type": "array"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OAuth providers and scopes."
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prefix the gateway prepends to tool names.",
          "title": "Prefix"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeOptions",
          "description": "Container runtime settings."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceModel"
            },
            {
              "$ref": "#/$defs/LocalSourceModel"
            }
          ],
          "description": "Git or local build source.",
          "title": "Source"
        },
        "build": {
          "$ref": "#/$defs/BuildOptions",
          "description": "Buildx platforms and build arguments."
        }
      },
      "required": [
        "schema_version",
        "name",
        "kind",
        "title",
        "description",
        "source",
        "build"
      ],
      "title": "BuildServer",
      "type": "object"
    },
    "ConfigModel": {
      "additionalProperties": false,
      "description": "User-configurable settings schema (Docker catalog ``config[]`` object).\n\nProperties are JSON Schema fragments and are referenced from env values, command\narguments, volumes and headers with ``{{server-name.property}}`` templates.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Configuration object name; defaults to the server name.",
          "title": "Name"
        },
        "description": {
          "description": "Explains what these settings configure.",
          "title": "Description",
          "type": "string"
        },
        "type": {
          "const": "object",
          "default": "object",
          "description": "Always object.",
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "Property name to JSON Schema (type, description, default, items, enum...).",
          "title": "Properties"
        },
        "required": {
          "description": "Properties the user must provide.",
          "items": {
            "type": "string"
          },
          "title": "Required",
          "type": "array"
        },
        "any_of": {
          "description": "The user must satisfy at least one requirement set.",
          "items": {
            "$ref": "#/$defs/RequirementSet"
          },
          "title": "Any Of",
          "type": "array"
        },
        "one_of": {
          "description": "The user must satisfy exactly one requirement set.",
          "items": {
            "$ref": "#/$defs/RequirementSet"
          },
          "title": "One Of",
          "type": "array"
        }
      },
      "required": [
        "description",
        "properties"
      ],
      "title": "ConfigModel",
      "type": "object"
    },
    "EnvModel": {
      "additionalProperties": false,
      "description": "Static environment variable set in the server container.",
      "properties": {
        "name": {
          "description": "Environment variable name.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "description": "Value. May reference user configuration with {{server-name.property}} templates.",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "EnvModel",
      "type": "object"
    },
    "ImageServer": {
      "additionalProperties": false,
