              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of a small PNG, SVG or favicon logo (max 512x512).",
          "title": "Icon"
        },
        "readme": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of the server documentation.",
          "title": "Readme"
        },
        "upstream": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL of the upstream project. Defaults to the Git source repository for build servers; set it when the image wraps a project hosted elsewhere.",
          "title": "Upstream"
        },
        "date_added": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the server was added to the catalog (RFC 3339). Declared, not computed.",
          "title": "Date Added"
        },
        "metadata": {
          "$ref": "#/$defs/MetadataModel",
          "description": "Category, tags, license and owner."
        },
        "tools": {
          "description": "Tools advertised in the catalog, declared inline.",
          "items": {
            "$ref": "#/$defs/ToolModel"
          },
          "title": "Tools",
          "type": "array"
        },
        "tools_file": {
          "anyOf": [
            {
              "format": "file-path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON or YAML file containing the tools list instead of declaring it inline. Relative paths resolve from the manifest directory; $GIT_BASE, $CWD and environment variables are expanded. Mutually exclusive with tools.",
          "title": "Tools File"
        },
        "secrets": {
          "description": "Secrets the gateway injects at start-up.",
          "items": {
            "$ref": "#/$defs/SecretModel"
          },
          "title": "Secrets",
          "type": "array"
        },
        "config": {
          "description": "User-configurable settings schemas.",
          "items": {
            "$ref": "#/$defs/ConfigModel"
          },
          "title": "Config",
          "type": "array"
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OAuth providers and scopes."
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prefix the gateway prepends to tool names.",
          "title": "Prefix"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeOptions",
          "description": "Container runtime settings."
        },
        "image": {
          "description": "Digest-pinned image reference (name@sha256:...).",
          "title": "Image",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "name",
        "kind",
        "title",
        "description",
        "image"
      ],
      "title": "ImageServer",
      "type": "object"
    },
    "LocalSourceModel": {
      "additionalProperties": false,
      "description": "Build context maintained next to the manifest instead of in an upstream repository.",
      "properties": {
        "context": {
          "description": "Existing build context directory. Relative paths resolve from the manifest directory; $GIT_BASE, $CWD and environment variables are expanded.",
          "format": "directory-path",
          "title": "Context",
          "type": "string"
        },
        "dockerfile": {
          "description": "Existing Dockerfile inside the context; relative paths resolve from it.",
          "format": "file-path",
          "title": "Dockerfile",
          "type": "string"
        }
      },
      "required": [
        "context",
        "dockerfile"
      ],
      "title": "LocalSourceModel",
      "type": "object"
    },
    "MetadataModel": {
      "additionalProperties": false,
      "description": "Descriptive metadata used for categorisation in catalog UIs.\n\nPull and star counters are computed by Docker Hub and cannot be declared here.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Category such as devops, database or productivity.",
          "title": "Category"
        },
        "tags": {
          "description": "Search tags.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SPDX identifier or license name of the server software.",
          "title": "License"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maintainer or organisation owning the server.",
          "title": "Owner"
        }
      },
      "title": "MetadataModel",
      "type": "object"
    },
    "OAuthModel": {
      "additionalProperties": false,
      "description": "OAuth configuration for servers that authenticate users.",
      "properties": {
        "providers": {
          "description": "Supported OAuth providers.",
          "items": {
            "$ref": "#/$defs/OAuthProvider"
          },
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "scopes": {
          "description": "OAuth scopes to request.",
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "providers"
      ],
      "title": "OAuthModel",
      "type": "object"
    },
    "OAuthProvider": {
      "additionalProperties": false,
      "description": "OAuth provider whose token the gateway injects as an environment variable.",
      "properties": {
        "provider": {
          "description": "Provider identifier such as github.",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "secret": {
          "description": "Secret name that stores the token, usually <server-name>.<key>.",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9._-]+$",
          "title": "Secret",
          "type": "string"
        },
        "env": {
          "description": "Environment variable for the token.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Env",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "secret",
        "env"
      ],
      "title": "OAuthProvider",
      "type": "object"
    },
    "RemoteEndpoint": {
      "additionalProperties": false,
      "description": "Hosted MCP endpoint reached over HTTP.",
      "properties": {
        "url": {
          "description": "HTTP(S) URL of the remote MCP endpoint. Environment variables are expanded.",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "transport_type": {
          "default": "streamable-http",
          "description": "MCP transport used by the endpoint (Docker catalog remote.transport_type).",
          "enum": [
            "streamable-http",
            "sse"
          ],
          "title": "Transport Type",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Static HTTP headers sent with every request. Values may reference configuration with {{server-name.property}} templates.",
          "title": "Headers",
          "type": "object"
        }
      },
      "required": [
        "url"
      ],
      "title": "RemoteEndpoint",
      "type": "object"
    },
